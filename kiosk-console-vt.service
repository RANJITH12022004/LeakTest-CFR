[Unit]
Description=Keep HDMI console on kiosk virtual terminal (tty2), allow tty1 developer shell
DefaultDependencies=no
After=local-fs.target
# Do not Conflict with getty@tty1 — Ctrl+Alt+F1 must stay usable for developers.
Before=getty@tty2.service

[Service]
Type=simple
ExecStart=/bin/bash /opt/kiosk/scripts/kiosk_console_vt.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
